{%- import '_macros.html.j2' as m with context -%}
<!doctype html>
<html lang="en"{% if print_mode %} data-theme="light"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="FinRobot visual report">
<meta name="description" content="{{ meta.company_name }} ({{ meta.ticker }}) equity research: seven panels, each with a conclusion and verdicts. Price snapshot {{ meta.snapshot.price_date }}.">
<title>{{ meta.company_name }} ({{ meta.ticker }}): equity report, {{ meta.report_date }}</title>
{%- if not print_mode %}
<script>
(function () {
  try {
    var t = localStorage.getItem("report-theme");
    if (!t && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) t = "dark";
    if (t) document.documentElement.setAttribute("data-theme", t);
  } catch (e) { /* theme falls back to the CSS default */ }
})();
</script>
{%- endif %}
<style>
{{ css | safe }}
</style>
{%- if print_mode %}
<style>
@page {
  @top-left { content: "{{ (meta.company_name ~ ' (' ~ meta.ticker ~ ')') | replace('\\', '') | replace('"', '') }}"; font: 7.5pt system-ui, Arial, sans-serif; color: #4a5360; }
  @top-right { content: "Report date {{ meta.report_date }}   |   Price snapshot {{ meta.snapshot.price_date }}"; font: 7.5pt system-ui, Arial, sans-serif; color: #4a5360; }
  @bottom-left { content: "Prices are the snapshot date shown. Not investment advice."; font: 7pt system-ui, Arial, sans-serif; color: #4a5360; }
}
.pagehead, .pagefoot { display: none !important; }
</style>
{%- endif %}
</head>
<body class="{{ 'print' if print_mode else 'screen' }}">
<a class="skip" href="#report">Skip to the report</a>
<div class="pagehead" aria-hidden="true"><span>{{ meta.company_name }} ({{ meta.ticker }}) equity report</span><span>Price snapshot {{ meta.snapshot.price_date }}</span></div>
<div class="pagefoot" aria-hidden="true">Report date {{ meta.report_date }}. Prices are the snapshot above. Not investment advice.</div>
<div id="page-probe" class="pageprobe" aria-hidden="true"></div>

<div class="layout">
{%- if not print_mode %}
  <nav id="nav" class="nav" aria-label="Report sections">
    <div class="nav__bar">
      <button type="button" id="nav-toggle" class="nav__toggle" aria-expanded="false" aria-controls="nav-list"><span class="nav__pos" id="nav-pos">1 of {{ panels | length }}</span><span id="nav-text">{{ panels[0].headline }}</span></button>
      <button type="button" id="theme-btn" class="theme-btn" aria-pressed="false">Dark theme</button>
    </div>
    <ol id="nav-list" class="nav__list">
      {%- for pn in panels %}
      <li><a class="nav__link" href="#p-{{ pn.id }}" data-panel="{{ pn.id }}" data-n="{{ pn.n }}" data-headline="{{ pn.headline }}"><span class="nav__n">{{ pn.n }}</span>{{ pn.headline }}</a></li>
      {%- endfor %}
    </ol>
  </nav>
{%- endif %}

  <div class="content">
  <main id="report">
{%- for pn in panels %}
    <section class="panel{% if pn.charts | selectattr('role', 'equalto', 'small') | list %} has-small{% endif %}" id="p-{{ pn.id }}" data-panel-id="{{ pn.id }}" data-print-panel="{{ pn.n }}" aria-labelledby="h-{{ pn.id }}">
    {%- if pn.id == 'summary' %}
        <div class="strip">
          <div class="strip__title">
            <h1>{{ meta.company_name }}</h1><span class="ticker">{{ meta.ticker }}</span>
            {%- if meta.sector %}<span class="sector">{{ meta.sector }}</span>{% endif %}
            <span class="rdate">Report date {{ meta.report_date }}</span>
          </div>
          <dl class="strip__facts">
            <div><dt>Share price</dt><dd>Rs {{ meta.snapshot.price | inr(2) }}<small>Snapshot {{ meta.snapshot.price_date }}{% if meta.snapshot.price_time %}, {{ meta.snapshot.price_time }}{% endif %}</small></dd></div>
            <div><dt>Market cap</dt><dd>Rs {{ meta.snapshot.market_cap_cr | inr(0) }} cr</dd></div>
            <div><dt>52-week range</dt><dd>Rs {{ meta.snapshot.week52_low | inr(2) }} to Rs {{ meta.snapshot.week52_high | inr(2) }}</dd></div>
          </dl>
        </div>
    {%- endif %}
      <p class="panel__kicker"><b>Panel {{ pn.n }} of {{ panels | length }}</b>{% if pn.question %}: {{ pn.question }}{% endif %}</p>
      <h2 class="panel__headline" id="h-{{ pn.id }}">{{ pn.headline }}</h2>
      <div class="panel__body">
{%- set ex = pn.extra or {} %}

{#- ===== panel 1: header strip, thesis, warnings, lights, price-vs-earnings ===== #}
{%- if pn.id == 'summary' %}
        {%- if model.thesis %}<p class="thesis">{{ gl(model.thesis) }}</p>{% endif %}

        {%- set flags = model.warnings or [] %}
        {%- if flags %}
        <section class="warnings" aria-labelledby="warn-h" role="region">
          <h3 id="warn-h">Data warnings and limits</h3>
          <ul>{% for w in flags %}<li><span class="lvl lvl--{{ w.level }}">{{ lvl_word[w.level] if w.level in lvl_word else w.level }}</span><span>{{ w.text }}</span></li>{% endfor %}</ul>
        </section>
        {%- else %}
        <section class="warnings warnings--ok" aria-labelledby="warn-h" role="region">
          <h3 id="warn-h">Data checks</h3>
          <p>No validation flags. {{ ((model.sources or {}).validation or {}).passed | length }} check groups passed.</p>
        </section>
        {%- endif %}

        {%- if ex.lights %}
        <ul class="lights" aria-label="Four traffic lights">
          {%- for l in ex.lights %}
          <li class="light light--{{ l.light }}"><div class="light__head">{{ m.badge(l.light) }}<span>{{ l.label }}</span></div><p>{{ gl(l.reason) }}</p></li>
          {%- endfor %}
        </ul>
        {%- endif %}

        {%- set pv = ex.price_vs_earnings %}
        {%- if pv %}
        <section class="pve" aria-labelledby="pve-h">
          <h3 id="pve-h">Price says / earnings say</h3>
          <div class="pve__nums">
            {%- if pv.price_change_1y_pct is not none %}<div><b>{{ pv.price_change_1y_pct | signed(0) }}%</b><span>Share price, 1 year</span></div>{% endif %}
            {%- if pv.eps_fy_change_pct is not none %}<div><b>{{ pv.eps_fy_change_pct | signed(0) }}%</b><span>EPS, last full year</span></div>{% endif %}
            {%- if pv.eps_ttm_change_pct is not none %}<div><b>{{ pv.eps_ttm_change_pct | signed(0) }}%</b><span>EPS, trailing 12 months</span></div>{% endif %}
          </div>
          {%- if pv.sentence %}<p>{{ gl(pv.sentence) }}</p>{% endif %}
        </section>
        {%- endif %}
{%- endif %}

{#- ===== charts (main first, then small) ===== #}
{%- set mains = pn.charts | selectattr('role', 'equalto', 'main') | list %}
{%- set smalls = pn.charts | selectattr('role', 'equalto', 'small') | list %}
{%- if mains %}<div class="charts">{% for c in mains %}{{ m.chart(pn, c) }}{% endfor %}</div>{% endif %}
{%- if smalls %}<div class="charts charts--small">{% for c in smalls %}{{ m.chart(pn, c) }}{% endfor %}</div>{% endif %}

{#- ===== panel-specific blocks ===== #}
{%- if pn.id == 'profit_engine' %}
  {%- if ex.bridge or ex.operating_leverage %}
        <div class="callouts">
          {%- if ex.bridge and ex.bridge.text %}<p class="callout"><b>Margin bridge, {{ ex.bridge['from'] }} to {{ ex.bridge.to }}.</b> {{ gl(ex.bridge.text) }}</p>{% endif %}
          {%- if ex.operating_leverage and ex.operating_leverage.text %}<p class="callout"><b>Operating leverage.</b> {{ gl(ex.operating_leverage.text) }}</p>{% endif %}
        </div>
  {%- endif %}
{%- endif %}

{%- if pn.id == 'price' %}
  {%- if ex.verdict_sentence %}<p class="verdict-line">{{ gl(ex.verdict_sentence) }}</p>{% endif %}
  {%- if ex.tests %}
        <ul class="tiles" aria-label="Four independent tests">
          {%- for t in ex.tests %}
          <li class="tile tile--{{ t.verdict }}"><div>{{ m.badge(t.verdict) }}</div><span class="tile__label">{{ t.label }}</span><span class="tile__state">{{ t.state }}</span><span class="tile__measures">Measures: {{ t.measures }}</span><span class="tile__evidence">{{ t.evidence }}</span></li>
          {%- endfor %}
        </ul>
  {%- endif %}
  {%- if (ex.divergence and (ex.divergence.sentence or ex.divergence.text)) or ex.rsi_zone %}
  <p class="callout">{% if ex.divergence and (ex.divergence.sentence or ex.divergence.text) %}<b>Divergence.</b> {{ ex.divergence.sentence or ex.divergence.text }}{% endif %}{% if ex.rsi_zone %} <b>RSI zone.</b> {{ ex.rsi_zone }}{% endif %}</p>
  {%- endif %}
{%- endif %}

{%- if pn.id == 'valuation' and ex.fair_value_cases %}
        <section class="table-card" aria-labelledby="fv-h">
          <h3 id="fv-h">Fair value per share against today's price of Rs {{ (ex.price if ex.price is not none else meta.snapshot.price) | inr(2) }}</h3>
          <div class="tablewrap" tabindex="0" role="region" aria-label="Fair value cases">
            <table>
              <thead><tr><th scope="col">Case</th><th scope="col">Basis</th><th scope="col">Value per share</th><th scope="col">Against today's price</th></tr></thead>
              <tbody>
              {%- for f in ex.fair_value_cases %}
                <tr><th scope="row">{{ f.label }}</th><td>{{ f.basis }}</td><td>Rs {{ f.low_price | inr(0) }} to Rs {{ f.high_price | inr(0) }}</td><td>{{ f.vs_price_pct_low | signed(0) }}% to {{ f.vs_price_pct_high | signed(0) }}%</td></tr>
              {%- endfor %}
              </tbody>
            </table>
          </div>
        </section>
  {%- if ex.toggle_note %}<p class="callout">{{ ex.toggle_note }}</p>{% endif %}
{%- endif %}

{%- if pn.id == 'watch' %}
  {%- if ex.signposts %}
        <section class="table-card signposts" aria-labelledby="sp-h">
          <h3 id="sp-h">Signposts</h3>
          <div class="tablewrap" tabindex="0" role="region" aria-label="Signposts to watch">
            <table>
              <thead><tr><th scope="col">Metric</th><th scope="col">Now</th><th scope="col">Threshold</th><th scope="col">Status</th><th scope="col">Why it matters</th></tr></thead>
              <tbody>
              {%- for s in ex.signposts %}
                <tr><th scope="row">{{ s.metric }}</th><td>{{ s.current_text }}</td><td>{{ s.threshold_text }}</td><td>{{ m.badge(s.status) }}</td><td>{{ gl(s.why) }}</td></tr>
              {%- endfor %}
              </tbody>
            </table>
          </div>
        </section>
  {%- endif %}
  {%- set pf = ex.portfolio or {} %}
  {%- if pf.current_weight is not none or pf.target_weight is not none or pf.triggers %}
        <section class="portfolio" aria-labelledby="pf-h">
          <h3 id="pf-h">Your portfolio</h3>
          <p>Current weight: {{ pf.current_weight if pf.current_weight is not none else 'not set' }}. Target weight: {{ pf.target_weight if pf.target_weight is not none else 'not set' }}.</p>
          {%- if pf.triggers %}<p>Trim or add triggers: {{ pf.triggers }}</p>{% endif %}
        </section>
  {%- endif %}
{%- endif %}

{%- if ex.readings and pn.id == 'price' %}
        <section class="table-card" aria-labelledby="rd-h">
          <h3 id="rd-h">Technical readings</h3>
          {%- if print_mode and ex.readings | length > 4 %}
          {%- set half = ((ex.readings | length) + 1) // 2 %}
          <div class="readings2">
            {%- for part in [ex.readings[:half], ex.readings[half:]] %}
            <table>
              <thead><tr><th scope="col">Reading</th><th scope="col">Value</th><th scope="col">Note</th></tr></thead>
              <tbody>{% for r in part %}<tr><th scope="row">{{ r[0] }}</th><td>{{ r[1] }}</td><td>{{ r[2] }}</td></tr>{% endfor %}</tbody>
            </table>
            {%- endfor %}
          </div>
          {%- else %}
          <div class="tablewrap" tabindex="0" role="region" aria-label="Technical readings">
            <table>
              <thead><tr><th scope="col">Reading</th><th scope="col">Value</th><th scope="col">Note</th></tr></thead>
              <tbody>{% for r in ex.readings %}<tr><th scope="row">{{ r[0] }}</th><td>{{ r[1] }}</td><td>{{ r[2] }}</td></tr>{% endfor %}</tbody>
            </table>
          </div>
          {%- endif %}
        </section>
{%- endif %}

{#- ===== verdict chips ===== #}
{%- if pn.chips %}
        <div class="chips" aria-label="Verdicts for this panel">
          {%- for v in pn.chips %}{{ m.chip(v, pn.id ~ '-' ~ loop.index) }}{% endfor %}
        </div>
{%- endif %}

{%- if pn.notes %}
        <ul class="notes">{% for n in pn.notes %}<li>{{ gl(n) }}</li>{% endfor %}</ul>
{%- endif %}
      </div>
    </section>
{%- endfor %}
  </main>

  <footer class="endmatter" id="endmatter">
    <section class="glossary" aria-labelledby="gloss-h">
      <h2 id="gloss-h">Glossary</h2>
      <dl>
        {%- for g in glossary %}
        <dt id="gl-{{ g.id }}">{{ g.term }}</dt><dd>{{ g.definition }}</dd>
        {%- endfor %}
      </dl>
    </section>

    <section class="datanotes" aria-labelledby="src-h">
      <h2 id="src-h">Sources and data notes</h2>
      <ul class="plain-list">
        <li>Data provider: {{ (sources.provider if sources else '') or 'not stated' }}.</li>
        {%- if sources and sources.snapshot %}<li>Price snapshot: {{ sources.snapshot }}</li>{% endif %}
        {%- for d in (sources.definitions if sources else []) %}<li>{{ d }}</li>{% endfor %}
      </ul>
      <h3 class="chart__title" style="margin-top:14px">How each verdict was calculated</h3>
      {%- for pn in panels %}{% for v in pn.chips %}
      <details{% if print_mode %} open{% endif %}><summary>{{ v.label }} ({{ v.period }}): {{ verdict_word[v.verdict] }}, {{ v.yardstick_text }}</summary><p>{{ v.calc or 'No calculation note supplied.' }} Source: {{ source_text[v.source] if v.source in source_text else v.source }}.</p></details>
      {%- endfor %}{% endfor %}
      {%- set val = (sources.validation if sources else none) or {} %}
      <div class="validation">
        <h3>Validation results</h3>
        {%- if val.errors %}<div><b>Errors</b><ul class="plain-list">{% for x in val.errors %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
        {%- if val.warnings %}<div><b>Warnings</b><ul class="plain-list">{% for x in val.warnings %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
        {%- if val.passed %}<div><b>Passed</b><ul class="plain-list">{% for x in val.passed %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
        {%- if not (val.errors or val.warnings or val.passed) %}<p>No validation results were supplied.</p>{% endif %}
      </div>
    </section>

    <section aria-labelledby="disc-h">
      <h2 id="disc-h">Disclaimer</h2>
      <p class="disclaimer">{{ model.disclaimer }}</p>
    </section>
  </footer>
  </div>
</div>

<div id="live" class="sr-only" aria-live="polite"></div>
<script type="application/json" id="report-data">{{ model_json | safe }}</script>
<script>
{{ echarts_js | safe }}
</script>
<script>
{{ js | safe }}
</script>
</body>
</html>
