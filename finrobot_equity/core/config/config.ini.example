[API_KEYS]
# Financial Modeling Prep API Key
# Get your free API key at: https://financialmodelingprep.com/developer
fmp_api_key = YOUR_FMP_API_KEY

# FinEdge API token (optional, for Indian NSE/BSE stocks with --data-provider finedge)
# Get a token at: https://www.finedgeapi.com  (or set the FINEDGE_API_TOKEN environment variable)
finedge_api_token = YOUR_FINEDGE_API_TOKEN

# LLM for the AI text sections: openai | anthropic | gemini
# (override per run with --llm-provider; the web app has an AI Model selector)
llm_provider = openai

# Optional model override for the chosen provider. Defaults:
#   openai: gpt-4o-mini (or openai_model below), anthropic: claude-opus-5-5, gemini: gemini-2.5-flash
# llm_model = claude-sonnet-5-5

# Anthropic API key (for llm_provider = anthropic): https://platform.claude.com/settings/keys
anthropic_api_key = YOUR_ANTHROPIC_API_KEY

# Google Gemini API key (for llm_provider = gemini): https://aistudio.google.com/apikey
gemini_api_key = YOUR_GEMINI_API_KEY

# OpenAI API Key (or compatible API provider)
# Get your API key at: https://platform.openai.com/account/api-keys
openai_api_key = YOUR_OPENAI_API_KEY

# OpenAI Base URL (optional, change for proxy services like SiliconFlow)
# Default: https://api.openai.com/v1
openai_base_url = https://api.openai.com/v1

# Model name (optional, change for proxy services)
# Model name (optional, change for proxy services)
# OpenAI Model (choose one of the following ):
#   gpt-4.1       - Latest flagship model, best quality (recommended for production)
#   gpt-4.1-mini  - Fast and cost-effective (recommended for development/testing)
#   gpt-4o        - Previous generation flagship, stable and reliable
#   gpt-4o-mini   - Previous generation lightweight model
# Default: gpt-4.1-mini
openai_model = gpt-4.1

# Adanos Finance API key (optional, enables retail sentiment insights in equity reports)
adanos_api_key = YOUR_ADANOS_API_KEY

# Adanos base URL (optional)
# Default: https://api.adanos.org
adanos_base_url = https://api.adanos.org
